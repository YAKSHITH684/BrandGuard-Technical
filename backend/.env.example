# Database: PostgreSQL with pgvector (e.g. postgresql://postgres:postgres@localhost:5432/brandguard)
# Or leave as SQLite default (sqlite:///./brandguard.db) for local zero-dependency testing without Docker
DATABASE_URL=sqlite:///./brandguard.db

# Groq API Key for LLM review and structured JSON output
# Get free key at https://console.groq.com
GROQ_API_KEY=

# JWT Secret for session authentication
JWT_SECRET=brandguard_secure_jwt_secret_key_hackathon_round_2_build_2026

# Embedding Model (defaults to 384-dim semantic embedding)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Confidence threshold below which findings are marked cannot_verify
CONFIDENCE_THRESHOLD=0.65

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
